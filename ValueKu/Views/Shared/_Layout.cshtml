@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    string Active(string c) => string.Equals(controller, c, StringComparison.OrdinalIgnoreCase) ? "active" : "";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>@ViewData["Title"] · ValueKu</title>
    <link rel="icon" type="image/png" href="~/img/favicon-64.png" asp-append-version="true"/>
    <link rel="apple-touch-icon" href="~/img/apple-touch-icon.png" asp-append-version="true"/>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"/>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"/>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/ValueKu.styles.css" asp-append-version="true"/>
</head>
<body>
<div class="app-shell">
    <aside class="sidebar" id="sidebar">
        <div class="sidebar__brand">
            <img src="~/img/logo.png" alt="ValueKu" asp-append-version="true"/>
        </div>
        <nav class="sidebar__nav">
            <a class="@Active("Dashboard")" asp-controller="Dashboard" asp-action="Index"><i class="bi bi-speedometer2"></i> Dashboard</a>
            <a class="@Active("Assets")" asp-controller="Assets" asp-action="Index"><i class="bi bi-houses"></i> Assets</a>
            <a class="@Active("Accounts")" asp-controller="Accounts" asp-action="Index"><i class="bi bi-wallet2"></i> Accounts</a>
            <a class="@Active("Transactions")" asp-controller="Transactions" asp-action="Index"><i class="bi bi-arrow-left-right"></i> Transactions</a>
            <a class="@Active("Budgets")" asp-controller="Budgets" asp-action="Index"><i class="bi bi-pie-chart"></i> Budgets</a>
            <a class="@Active("Goals")" asp-controller="Goals" asp-action="Index"><i class="bi bi-flag"></i> Goals</a>
            <a class="@Active("Zakat")" asp-controller="Zakat" asp-action="Index"><i class="bi bi-moon-stars"></i> Zakat</a>
            <a class="@Active("Reports")" asp-controller="Reports" asp-action="Index"><i class="bi bi-file-earmark-pdf"></i> Reports</a>
        </nav>
        <div class="sidebar__footer">MYR · Malaysian Ringgit</div>
    </aside>

    <div class="app-main">
        <header class="topbar">
            <div class="d-flex align-items-center gap-3">
                <button class="btn btn-light sidebar-toggle" type="button" id="sidebarToggle" aria-label="Toggle navigation">
                    <i class="bi bi-list"></i>
                </button>
                <h1>@(ViewData["Title"] ?? "Dashboard")</h1>
            </div>
            <div class="d-flex align-items-center gap-2">
                <div class="dropdown">
                    <button class="btn btn-primary btn-sm dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                        <i class="bi bi-plus-lg me-1"></i>Add
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end">
                        <li><a class="dropdown-item" asp-controller="Transactions" asp-action="Create"><i class="bi bi-arrow-left-right me-2"></i>Transaction</a></li>
                        <li><a class="dropdown-item" asp-controller="Assets" asp-action="Create"><i class="bi bi-houses me-2"></i>Asset</a></li>
                        <li><a class="dropdown-item" asp-controller="Accounts" asp-action="Create"><i class="bi bi-wallet2 me-2"></i>Account</a></li>
                        <li><a class="dropdown-item" asp-controller="Budgets" asp-action="Create"><i class="bi bi-pie-chart me-2"></i>Budget</a></li>
                        <li><a class="dropdown-item" asp-controller="Goals" asp-action="Create"><i class="bi bi-flag me-2"></i>Savings goal</a></li>
                    </ul>
                </div>
                @{
                    var avatar = User.FindFirst("avatar")?.Value;
                }
                <div class="dropdown">
                    <a href="#" class="text-decoration-none text-dark dropdown-toggle topbar__user" data-bs-toggle="dropdown" aria-expanded="false">
                        @if (!string.IsNullOrEmpty(avatar))
                        {
                            <img src="@avatar" alt="avatar" class="rounded-circle me-1" style="width:28px;height:28px;object-fit:cover;"/>
                        }
                        else
                        {
                            <i class="bi bi-person-circle me-1"></i>
                        }
                        @(User.Identity?.Name ?? "Account")
                    </a>
                    <ul class="dropdown-menu dropdown-menu-end">
                        <li><a class="dropdown-item" asp-controller="Profile" asp-action="Index"><i class="bi bi-person me-2"></i>Profile</a></li>
                        <li><hr class="dropdown-divider"></li>
                        <li>
                            <form asp-controller="Account" asp-action="Logout" method="post" class="px-2">
                                <button type="submit" class="dropdown-item"><i class="bi bi-box-arrow-right me-2"></i>Sign out</button>
                            </form>
                        </li>
                    </ul>
                </div>
            </div>
        </header>

        <main class="content">
            @if (TempData["Success"] is string success)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    <i class="bi bi-check-circle me-1"></i> @success
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @RenderBody()
        </main>
    </div>
</div>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/apexcharts@3.54.1/dist/apexcharts.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
