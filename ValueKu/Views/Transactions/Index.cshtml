@model TransactionIndexViewModel
@using ValueKu.Core.Enums
@{
    ViewData["Title"] = "Transactions";

    var routeData = new Dictionary<string, string>();
    if (Model.AccountId is { } aid) routeData["accountId"] = aid.ToString();
    if (Model.From is { } f) routeData["from"] = f.ToString("yyyy-MM-dd");
    if (Model.To is { } t) routeData["to"] = t.ToString("yyyy-MM-dd");
    if (Model.Type is { } ty) routeData["type"] = ty.ToString();
    if (Model.Category is { } c) routeData["category"] = c.ToString();
    if (!string.IsNullOrWhiteSpace(Model.Search)) routeData["search"] = Model.Search;
}

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <div class="text-muted small">
        @Model.TotalCount result(s) · Income <strong class="text-positive">@Model.TotalIncome.ToMyr()</strong> ·
        Expenses <strong class="text-negative">@Model.TotalExpense.ToMyr()</strong>
    </div>
    <a class="btn btn-primary" asp-action="Create"><i class="bi bi-plus-lg me-1"></i>Add Transaction</a>
</div>

<form method="get" class="card mb-3">
    <div class="card-body row g-2 align-items-end">
        <div class="col-md-3 col-6">
            <label class="form-label small mb-1">Account</label>
            <select name="accountId" class="form-select form-select-sm">
                <option value="">All accounts</option>
                @foreach (var a in Model.Accounts)
                {
                    <option value="@a.Value" selected="@(a.Selected ? "selected" : null)">@a.Text</option>
                }
            </select>
        </div>
        <div class="col-md-2 col-6">
            <label class="form-label small mb-1">From</label>
            <input type="date" name="from" value="@(Model.From?.ToString("yyyy-MM-dd"))" class="form-control form-control-sm"/>
        </div>
        <div class="col-md-2 col-6">
            <label class="form-label small mb-1">To</label>
            <input type="date" name="to" value="@(Model.To?.ToString("yyyy-MM-dd"))" class="form-control form-control-sm"/>
        </div>
        <div class="col-md-2 col-6">
            <label class="form-label small mb-1">Type</label>
            <select name="type" class="form-select form-select-sm">
                <option value="">All</option>
                @foreach (var ty in Enum.GetValues<TransactionType>())
                {
                    <option value="@ty" selected="@(Model.Type == ty ? "selected" : null)">@ty</option>
                }
            </select>
        </div>
        <div class="col-md-3 col-6">
            <label class="form-label small mb-1">Category</label>
            <select name="category" class="form-select form-select-sm">
                <option value="">All</option>
                @foreach (var c in Enum.GetValues<TransactionCategory>())
                {
                    <option value="@c" selected="@(Model.Category == c ? "selected" : null)">@c.DisplayName()</option>
                }
            </select>
        </div>
        <div class="col-md-9 col-9">
            <label class="form-label small mb-1">Search description</label>
            <input type="text" name="search" value="@Model.Search" class="form-control form-control-sm" placeholder="e.g. salary, fuel…"/>
        </div>
        <div class="col-md-3 col-3 d-flex gap-2">
            <button type="submit" class="btn btn-sm btn-primary flex-grow-1"><i class="bi bi-funnel"></i></button>
            <a asp-action="Index" class="btn btn-sm btn-light">Clear</a>
        </div>
    </div>
</form>

<div class="card">
    <div class="card-body p-0">
        @if (Model.Items.Count == 0)
        {
            <div class="text-center py-5">
                <i class="bi bi-inbox display-6 text-muted d-block mb-2"></i>
                <p class="text-muted mb-2">No transactions match your filters.</p>
                <a class="btn btn-primary btn-sm" asp-action="Create">Add a transaction</a>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table mb-0 align-middle">
                    <thead>
                    <tr>
                        <th>Date</th>
                        <th>Description</th>
                        <th>Account</th>
                        <th>Category</th>
                        <th class="text-end">Amount</th>
                        <th class="text-end">Actions</th>
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var tx in Model.Items)
                    {
                        <tr>
                            <td>@tx.TransactionDate.ToString("dd MMM yyyy")</td>
                            <td>
                                @(string.IsNullOrWhiteSpace(tx.Description) ? "—" : tx.Description)
                                @if (tx.IsRecurring)
                                {
                                    <i class="bi bi-arrow-repeat text-muted ms-1" title="Recurring"></i>
                                }
                            </td>
                            <td>@(tx.Account?.Name ?? "—")</td>
                            <td><span class="badge badge-soft">@tx.Category.DisplayName()</span></td>
                            <td class="text-end @(tx.Type == TransactionType.Income ? "text-positive" : "text-negative")">
                                @(tx.Type == TransactionType.Income ? "+" : "−")@tx.Amount.ToMyr()
                            </td>
                            <td class="text-end">
                                <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@tx.Id"><i class="bi bi-pencil"></i></a>
                                <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@tx.Id"><i class="bi bi-trash"></i></a>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@if (Model.TotalPages > 1)
{
    <nav class="mt-3">
        <ul class="pagination pagination-sm justify-content-center mb-0">
            <li class="page-item @(Model.Page <= 1 ? "disabled" : "")">
                <a class="page-link" asp-action="Index" asp-all-route-data="routeData" asp-route-page="@(Model.Page - 1)">Previous</a>
            </li>
            @for (var p = 1; p <= Model.TotalPages; p++)
            {
                <li class="page-item @(p == Model.Page ? "active" : "")">
                    <a class="page-link" asp-action="Index" asp-all-route-data="routeData" asp-route-page="@p">@p</a>
                </li>
            }
            <li class="page-item @(Model.Page >= Model.TotalPages ? "disabled" : "")">
                <a class="page-link" asp-action="Index" asp-all-route-data="routeData" asp-route-page="@(Model.Page + 1)">Next</a>
            </li>
        </ul>
    </nav>
}
