@model BudgetFormViewModel
<div class="row g-3">
    <div class="col-md-6">
        <label asp-for="Category" class="form-label"></label>
        <select asp-for="Category" asp-items="Html.GetEnumSelectList<TransactionCategory>()" class="form-select"></select>
        <span asp-validation-for="Category" class="text-danger small"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="MonthlyLimit" class="form-label"></label>
        <input asp-for="MonthlyLimit" class="form-control" type="number" step="0.01" min="1"/>
        <span asp-validation-for="MonthlyLimit" class="text-danger small"></span>
    </div>
</div>
