@model SavingsGoalFormViewModel
<div class="row g-3">
    <div class="col-12">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control" autofocus placeholder="e.g. Emergency Fund"/>
        <span asp-validation-for="Name" class="text-danger small"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="TargetAmount" class="form-label"></label>
        <input asp-for="TargetAmount" class="form-control" type="number" step="0.01" min="1"/>
        <span asp-validation-for="TargetAmount" class="text-danger small"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="CurrentAmount" class="form-label"></label>
        <input asp-for="CurrentAmount" class="form-control" type="number" step="0.01" min="0"/>
        <span asp-validation-for="CurrentAmount" class="text-danger small"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="TargetDate" class="form-label"></label>
        <input asp-for="TargetDate" class="form-control" type="date" asp-format="{0:yyyy-MM-dd}"/>
        <span asp-validation-for="TargetDate" class="text-danger small"></span>
    </div>
</div>
