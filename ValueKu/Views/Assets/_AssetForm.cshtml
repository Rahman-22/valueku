@model AssetFormViewModel
<div class="row g-3">
    <div class="col-md-6">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control" autofocus/>
        <span asp-validation-for="Name" class="text-danger small"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="Category" class="form-label"></label>
        <select asp-for="Category" asp-items="Html.GetEnumSelectList<AssetCategory>()" class="form-select"></select>
        <span asp-validation-for="Category" class="text-danger small"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="PurchasePrice" class="form-label"></label>
        <input asp-for="PurchasePrice" class="form-control" type="number" step="0.01" min="0"/>
        <span asp-validation-for="PurchasePrice" class="text-danger small"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="PurchaseDate" class="form-label"></label>
        <input asp-for="PurchaseDate" class="form-control" type="date" asp-format="{0:yyyy-MM-dd}"/>
        <span asp-validation-for="PurchaseDate" class="text-danger small"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="AppreciationDepreciationRate" class="form-label"></label>
        <input asp-for="AppreciationDepreciationRate" class="form-control" type="number" step="0.01"/>
        <div class="form-text">Positive = appreciation, negative = depreciation (% per year).</div>
        <span asp-validation-for="AppreciationDepreciationRate" class="text-danger small"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="CalculationType" class="form-label"></label>
        <select asp-for="CalculationType" asp-items="Html.GetEnumSelectList<CalculationType>()" class="form-select"></select>
        <div class="form-text">Linear = straight-line · Compounding = % of running balance.</div>
        <span asp-validation-for="CalculationType" class="text-danger small"></span>
    </div>
</div>
