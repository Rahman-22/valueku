@model Asset
@{
    ViewData["Title"] = "Delete Asset";
}

<div class="card">
    <div class="card-body p-4">
        <h5 class="mb-3">Delete <strong>@Model.Name</strong>?</h5>
        <p class="text-muted">This will permanently remove the asset and its valuation history. This action cannot be undone.</p>
        <dl class="row mb-4">
            <dt class="col-sm-3">Category</dt><dd class="col-sm-9">@Model.Category.DisplayName()</dd>
            <dt class="col-sm-3">Current Value</dt><dd class="col-sm-9">@Model.CurrentValue.ToMyr()</dd>
        </dl>
        <form asp-action="Delete" asp-route-id="@Model.Id" method="post">
            <button type="submit" class="btn btn-danger">Yes, delete</button>
            <a class="btn btn-light" asp-action="Index">Cancel</a>
        </form>
    </div>
</div>
