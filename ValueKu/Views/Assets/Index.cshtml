@model IReadOnlyList<Asset>
@{
    ViewData["Title"] = "Assets";
    var total = Model.Sum(a => a.CurrentValue);
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <p class="text-muted mb-0">Total current value: <strong>@total.ToMyr()</strong> across @Model.Count asset(s)</p>
    <a class="btn btn-primary" asp-action="Create"><i class="bi bi-plus-lg me-1"></i>Add Asset</a>
</div>

<div class="card">
    <div class="card-body p-0">
        @if (Model.Count == 0)
        {
            <div class="text-center py-5">
                <i class="bi bi-houses display-6 text-muted d-block mb-2"></i>
                <p class="text-muted mb-2">No assets yet. Add your first asset to start tracking its value.</p>
                <a class="btn btn-primary btn-sm" asp-action="Create">Add an asset</a>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table mb-0 align-middle">
                    <thead>
                    <tr>
                        <th>Name</th>
                        <th>Category</th>
                        <th>Method</th>
                        <th class="text-end">Purchase</th>
                        <th class="text-end">Rate</th>
                        <th class="text-end">Current Value</th>
                        <th class="text-end">Actions</th>
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var a in Model)
                    {
                        <tr>
                            <td><a asp-action="Details" asp-route-id="@a.Id" class="fw-semibold text-decoration-none">@a.Name</a></td>
                            <td><span class="badge badge-soft">@a.Category.DisplayName()</span></td>
                            <td>@a.CalculationType.DisplayName()</td>
                            <td class="text-end">@a.PurchasePrice.ToMyr()<div class="small text-muted">@a.PurchaseDate.ToString("dd MMM yyyy")</div></td>
                            <td class="text-end @(a.AppreciationDepreciationRate >= 0 ? "text-positive" : "text-negative")">@a.AppreciationDepreciationRate.ToString("0.##")%</td>
                            <td class="text-end fw-semibold">@a.CurrentValue.ToMyr()</td>
                            <td class="text-end">
                                <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@a.Id"><i class="bi bi-pencil"></i></a>
                                <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@a.Id"><i class="bi bi-trash"></i></a>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
