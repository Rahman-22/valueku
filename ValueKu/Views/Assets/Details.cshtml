@model Asset
@{
    ViewData["Title"] = Model.Name;
    var history = ViewBag.History as IReadOnlyList<AssetValuationHistory> ?? new List<AssetValuationHistory>();
    var labels = history.Select(h => h.RecordedDate.ToString("dd MMM yy")).ToList();
    var values = history.Select(h => h.Value).ToList();
    var gain = Model.CurrentValue - Model.PurchasePrice;
}

<div class="row g-3 mb-3">
    <div class="col-md-3"><div class="card stat-card"><div class="stat-label">Current Value</div><div class="stat-value">@Model.CurrentValue.ToMyr()</div></div></div>
    <div class="col-md-3"><div class="card stat-card"><div class="stat-label">Purchase Price</div><div class="stat-value">@Model.PurchasePrice.ToMyr()</div></div></div>
    <div class="col-md-3"><div class="card stat-card"><div class="stat-label">Gain / Loss</div><div class="stat-value @(gain >= 0 ? "text-positive" : "text-negative")">@gain.ToMyr()</div></div></div>
    <div class="col-md-3"><div class="card stat-card"><div class="stat-label">Annual Rate</div><div class="stat-value">@Model.AppreciationDepreciationRate.ToString("0.##")%</div></div></div>
</div>

<div class="card mb-3">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span>Valuation History</span>
        <span class="badge badge-soft">@Model.Category.DisplayName() · @Model.CalculationType.DisplayName()</span>
    </div>
    <div class="card-body">
        @if (values.Count == 0)
        {
            <p class="text-muted mb-0">No valuation history recorded yet.</p>
        }
        else
        {
            <div id="assetChart"></div>
        }
    </div>
</div>

<div class="d-flex gap-2">
    <a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.Id"><i class="bi bi-pencil me-1"></i>Edit</a>
    <a class="btn btn-light" asp-action="Index">Back to Assets</a>
</div>

@section Scripts {
    @if (values.Count > 0)
    {
        <script>
            const fmtMyr = (val) => (val == null) ? '' : 'RM ' + Number(val).toLocaleString('en-MY', { maximumFractionDigits: 0 });
            new ApexCharts(document.querySelector('#assetChart'), {
                chart: { type: 'area', height: 320, toolbar: { show: false }, fontFamily: 'inherit' },
                series: [{ name: '@Model.Name', data: @Html.Raw(JsonSerializer.Serialize(values)) }],
                xaxis: { categories: @Html.Raw(JsonSerializer.Serialize(labels)) },
                yaxis: { labels: { formatter: fmtMyr } },
                colors: ['#4f46e5'],
                stroke: { curve: 'smooth', width: 3 },
                fill: { type: 'gradient', gradient: { opacityFrom: 0.35, opacityTo: 0.02 } },
                dataLabels: { enabled: false },
                tooltip: { y: { formatter: fmtMyr } }
            }).render();
        </script>
    }
}
