@model ZakatResult
@using Microsoft.AspNetCore.Mvc.Rendering
@{
    ViewData["Title"] = "Zakat Calculator";
    var accounts = ViewBag.Accounts as IEnumerable<SelectListItem> ?? Enumerable.Empty<SelectListItem>();
}

<div class="row g-3">
    <div class="col-lg-7">
        <div class="card mb-3">
            <div class="card-header">Zakat-Eligible Wealth</div>
            <div class="card-body p-0">
                <table class="table mb-0 align-middle">
                    <tbody>
                    @foreach (var line in Model.Lines)
                    {
                        <tr>
                            <td>@line.Source</td>
                            <td class="text-end">@line.Amount.ToMyr()</td>
                        </tr>
                    }
                    @if (Model.Lines.Count == 0)
                    {
                        <tr><td colspan="2" class="text-muted">No eligible wealth recorded yet.</td></tr>
                    }
                    </tbody>
                    <tfoot>
                    <tr class="fw-bold border-top">
                        <td>Total eligible wealth</td>
                        <td class="text-end">@Model.EligibleWealth.ToMyr()</td>
                    </tr>
                    </tfoot>
                </table>
            </div>
        </div>

        <div class="card">
            <div class="card-body">
                <div class="d-flex justify-content-between mb-2">
                    <span class="text-muted">Nisab threshold</span>
                    <span>@Model.Nisab.ToMyr()</span>
                </div>
                <div class="d-flex justify-content-between mb-3">
                    <span class="text-muted">Status</span>
                    @if (Model.IsAboveNisab)
                    {
                        <span class="badge text-bg-success">Above nisab — zakat due</span>
                    }
                    else
                    {
                        <span class="badge text-bg-secondary">Below nisab — not obligatory</span>
                    }
                </div>
                <div class="p-3 rounded" style="background:var(--vk-accent-soft)">
                    <div class="text-muted small">Zakat payable (@Model.Rate.ToString("0.##")%)</div>
                    <div class="display-6 fw-bold" style="color:var(--vk-accent)">@Model.ZakatPayable.ToMyr()</div>
                </div>

                @if (Model.IsAboveNisab && accounts.Any())
                {
                    <form asp-action="Pay" method="post" class="mt-3">
                        <label class="form-label">Record a payment</label>
                        <div class="input-group">
                            <select name="accountId" class="form-select">
                                @foreach (var a in accounts)
                                {
                                    <option value="@a.Value">@a.Text</option>
                                }
                            </select>
                            <span class="input-group-text">RM</span>
                            <input type="number" name="amount" step="0.01" min="0.01" value="@Model.ZakatPayable.ToString("0.00")" class="form-control"/>
                            <button type="submit" class="btn btn-primary">Record</button>
                        </div>
                        <div class="form-text">Records an expense (category: Zakat) against the selected account.</div>
                    </form>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-5">
        <div class="card">
            <div class="card-header">About Zakat on Wealth</div>
            <div class="card-body small text-muted">
                <p>Zakat is an obligatory annual charity of <strong>2.5%</strong> on qualifying wealth for Muslims who meet the conditions.</p>
                <ul class="ps-3">
                    <li><strong>Nisab</strong> — wealth must exceed the minimum threshold (≈ the value of 85g of gold, currently around RM29,961).</li>
                    <li><strong>Ḥaul</strong> — the wealth must have been held for one full lunar year.</li>
                </ul>
                <p class="mb-0">This estimate includes cash/bank balances and liquid investments (ASB, unit trusts, equity, gold). Personal-use property, vehicles, and locked retirement savings (EPF, Tabung Haji) are excluded. Confirm the current nisab and your obligation with your state zakat authority (e.g. LZS, PPZ).</p>
            </div>
        </div>
    </div>
</div>
