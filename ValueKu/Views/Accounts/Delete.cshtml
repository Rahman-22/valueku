@model Account
@{
    ViewData["Title"] = "Delete Account";
}

<div class="card">
    <div class="card-body p-4">
        <h5 class="mb-3">Delete <strong>@Model.Name</strong>?</h5>
        <p class="text-muted">This will permanently remove the account and all of its transactions. This action cannot be undone.</p>
        <dl class="row mb-4">
            <dt class="col-sm-3">Type</dt><dd class="col-sm-9">@Model.Type.DisplayName()</dd>
            <dt class="col-sm-3">Balance</dt><dd class="col-sm-9">@Model.Balance.ToMyr()</dd>
        </dl>
        <form asp-action="Delete" asp-route-id="@Model.Id" method="post">
            <button type="submit" class="btn btn-danger">Yes, delete</button>
            <a class="btn btn-light" asp-action="Index">Cancel</a>
        </form>
    </div>
</div>
